DJANGO_SECRET_KEY=change-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
APP_TIME_ZONE=Asia/Kolkata
DJANGO_SECURE_SSL_REDIRECT=True

# Model runtime configuration
FER_MODEL_PATH=/Users/apple/Applications/Emotional Detection/ml/artifacts/emotion_classifier.joblib
FER_MODEL_VERSION=fer2013-sklearn-v2
FER_MAX_UPLOAD_MB=8
FER_MAX_IMAGE_PIXELS=4000000
FER_MAX_BASE64_BYTES=10000000
FER_ENABLE_RULE_BASED_CORRECTION=True
FER_ENABLE_CONFIDENCE_FALLBACK=False
FER_MIN_CONFIDENCE=0.35
FER_MIN_MARGIN=0.05
FER_FALLBACK_EMOTION=neutral
FER_API_RATE_LIMIT_IMAGE_PER_MIN=24
FER_API_RATE_LIMIT_LIVE_PER_MIN=60
FER_API_RATE_LIMIT_SAMPLE_PER_MIN=40
FER_TRUST_X_FORWARDED_FOR=False
FER_REQUIRE_AUTH=False

# Optional PostgreSQL settings (used when DATABASE_URL is defined)
DATABASE_URL=postgres
POSTGRES_DB=emotiondetect
POSTGRES_USER=emotiondetect
POSTGRES_PASSWORD=emotiondetect
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Security flags
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_LOG_LEVEL=INFO
