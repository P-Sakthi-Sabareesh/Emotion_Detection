# --- Django core ------------------------------------------------------------
# Must be at least 50 characters in production. Rotate on compromise.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-50-chars-long
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
APP_TIME_ZONE=UTC
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=json

# --- Model runtime ----------------------------------------------------------
FER_MODEL_PATH=ml/artifacts/emotion_classifier.joblib
FER_MODEL_MANIFEST_PATH=ml/artifacts/artifact_manifest.json
FER_MODEL_VERSION=fer2013-sklearn-v2
FER_REQUIRE_SIGNED_ARTIFACT=True
# HMAC secret used by ml/scripts/sign_artifact.py and inference/model_loader.py.
# Store in a secrets manager, never commit.
FER_MODEL_SIGNING_KEY=

# --- Upload hardening -------------------------------------------------------
FER_MAX_UPLOAD_MB=8
FER_MAX_IMAGE_PIXELS=4000000
FER_MAX_BASE64_BYTES=10000000
FER_ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP

# --- Post-processing --------------------------------------------------------
FER_ENABLE_RULE_BASED_CORRECTION=True
FER_ENABLE_CONFIDENCE_FALLBACK=False
FER_MIN_CONFIDENCE=0.35
FER_MIN_MARGIN=0.05
FER_FALLBACK_EMOTION=neutral

# --- Rate limit -------------------------------------------------------------
FER_RATE_LIMIT_BACKEND=redis
FER_API_RATE_LIMIT_IMAGE_PER_MIN=24
FER_API_RATE_LIMIT_LIVE_PER_MIN=60
FER_API_RATE_LIMIT_SAMPLE_PER_MIN=40
FER_TRUST_X_FORWARDED_FOR=False

# --- Auth -------------------------------------------------------------------
FER_REQUIRE_AUTH=True
# Comma-separated bearer tokens accepted on /api/v1/predict/* endpoints.
FER_API_TOKENS=

# --- Consent & retention ---------------------------------------------------
FER_REQUIRE_CONSENT=True
FER_STORE_PREDICTIONS=True
FER_STORE_IMAGES=False
FER_IP_ANONYMIZE=True
FER_RETENTION_DAYS=30

# --- Postgres (used only when DATABASE_URL is set) -------------------------
DATABASE_URL=
POSTGRES_DB=emotiondetect
POSTGRES_USER=emotiondetect
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_SSLMODE=prefer

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Security flags ---------------------------------------------------------
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
