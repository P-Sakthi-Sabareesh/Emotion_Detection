.venv/
__pycache__/
*.pyc

db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Secrets — never commit
.env
.env.*
!.env.example

# Dataset cache — users pull via ml/scripts/prepare_hf_fer2013.py
data/raw/

# Model artifacts — generated by scripts/bootstrap_model.py, never committed.
# Runtime verifies them via HMAC-signed manifest; each deployment signs with
# its own FER_MODEL_SIGNING_KEY.
ml/artifacts/*
!ml/artifacts/.gitkeep

# Local AI/plugin state — never commit
.claude/
.omc/
CLAUDE.local.md

# Test artifacts + scratch files
home.html
hub.html
grey96.png
live_body*.json

# Tooling
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
Thumbs.db
